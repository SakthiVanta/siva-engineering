# Postgres connection (Drizzle). Local:  postgres://USER:PASSWORD@localhost:5432/siva_engineering
# Managed (Neon, Supabase…) also works — TLS and pooler settings are handled automatically.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/siva_engineering

# Public canonical origin â€” used for sitemap, canonical URLs, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: salt for hashing visitor IPs stored with enquiries (any random string).
IP_HASH_SALT=change-me

# Optional: search-console verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
